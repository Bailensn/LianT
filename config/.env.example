# LianT 配置（复制成 .env，改完保存即生效）
# Telegram Bot Token：找 @BotFather 创建机器人后拿到，形如 123456789:AA...
LIANT_BOT_TOKEN=

# ---- 可选（下面这些只在任务进程启动时读一次，改完要 ./LianT restart）----
# 自建 API 网关 / 反代（默认官方地址）
# LIANT_API_BASE=https://api.telegram.org
# HTTP/SOCKS5 代理，例如 http://127.0.0.1:7890 或 socks5://127.0.0.1:1080
# LIANT_PROXY=

# 控制端口：一台机器跑多个实例时各用一个
# LIANT_PORT=28741
# LIANT_BIND=127.0.0.1
# LIANT_DATA_DIR=
# LIANT_DB_FILE=
# LIANT_LOG_FILE=
# LIANT_PID_FILE=
# LIANT_RUNTIME_FILE=
# LIANT_ENV_FILE=

# Webhook（可选；不设则用长轮询。需要公网 HTTPS）
# LIANT_WEBHOOK_URL=https://example.com/telegram/webhook
# LIANT_WEBHOOK_SECRET=随机字符串（A-Za-z0-9_-）
# LIANT_WEBHOOK_LISTEN=127.0.0.1:28743
# LIANT_WEBHOOK_PATH=/telegram/webhook

# 网页管理端
# LIANT_ADMIN_ADDR=127.0.0.1:28742
# LIANT_ADMIN_TOKEN=
# LIANT_ADMIN_PREFIX=
# LIANT_ADMIN_HTML=
# LIANT_ADMIN_ENABLE=true
