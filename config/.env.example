# LianT 配置（复制成 .env，改完保存即生效）
# 注意：Bot token 不在这里，存在 SQLite 的 bots 表里，支持多个 Bot。
# 旧版 LIANT_BOT_TOKEN 会在首次启动时自动导入一次（迁移用）。
# 敏感字段默认用 <数据目录>/secret.key 加密；也可以固定成环境变量：
# LIANT_SECRET=一个足够长的随机口令（设置后不要再改，否则旧 token 解不开）

# ---- 可选（下面这些只在任务进程启动时读一次，改完要 ./LianT restart）----
# 自建 API 网关 / 反代（默认官方地址）
# LIANT_API_BASE=https://api.telegram.org
# HTTP/SOCKS5 代理，例如 http://127.0.0.1:7890 或 socks5://127.0.0.1:1080
# LIANT_PROXY=

# 控制端口：一台机器跑多个实例时各用一个
# LIANT_PORT=28741
# LIANT_BIND=127.0.0.1
# LIANT_DATA_DIR=
# LIANT_DB_FILE=
# LIANT_LOG_FILE=
# LIANT_PID_FILE=
# LIANT_RUNTIME_FILE=
# LIANT_ENV_FILE=

# Webhook 每个 Bot 单独配置（网页「机器人」），不放 .env。

# 网页管理端
# LIANT_ADMIN_ADDR=127.0.0.1:28742
# 直接给管理端上 TLS（也可以交给 Caddy/Nginx 反代）：
# LIANT_ADMIN_TLS_CERT=/path/fullchain.pem
# LIANT_ADMIN_TLS_KEY=/path/privkey.pem
# LIANT_ADMIN_TOKEN=
# LIANT_ADMIN_PREFIX=
# LIANT_ADMIN_HTML=
# LIANT_ADMIN_ENABLE=true
